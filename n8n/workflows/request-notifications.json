      "parameters": {
        "jsCode": "\nconst crypto = require(\"crypto\");\n\nconst items = $input.all();\n\nif (items.length !== 1) {\n  return [{\n    json: {\n      valid: false,\n      reason: \"Expected exactly one webhook request.\"\n    }\n  }];\n}\n\nconst item = items[0];\nconst headers = item.json.headers ?? {};\n\n// Read the HMAC secret from the n8n environment\nconst secretHex = $env.LENDLOOP_HMAC_SECRET;\n\nif (\n  typeof secretHex !== \"string\" ||\n  !/^[0-9a-f]{64}$/i.test(secretHex)\n) {\n  return [{\n    json: {\n      valid: false,\n      reason: \"Invalid secret configuration.\"\n    }\n  }];\n}\n\n// Read authentication headers\nconst timestampHeader = headers[\"x-lendloop-timestamp\"];\nconst receivedSignature = headers[\"x-lendloop-signature\"];\n\nif (\n  typeof timestampHeader !== \"string\" ||\n  !/^\\d+$/.test(timestampHeader)\n) {\n  return [{\n    json: {\n      valid: false,\n      reason: \"Invalid timestamp.\"\n    }\n  }];\n}\n\nconst timestamp = Number(timestampHeader);\nconst currentTime = Math.floor(Date.now() / 1000);\n\nif (\n  !Number.isSafeInteger(timestamp) ||\n  Math.abs(currentTime - timestamp) > 300\n) {\n  return [{\n    json: {\n      valid: false,\n      reason: \"Expired or invalid timestamp.\"\n    }\n  }];\n}\n\nif (\n  typeof receivedSignature !== \"string\" ||\n  !/^[0-9a-f]{64}$/i.test(receivedSignature)\n) {\n  return [{\n    json: {\n      valid: false,\n      reason: \"Invalid signature format.\"\n    }\n  }];\n}\n\n// Read the original body from the Webhook binary property.\n// The Webhook node screenshot showed this property as \"data\".\nconst rawBody = await this.helpers.getBinaryDataBuffer(0, \"data\");\n\n// Convert secret from hexadecimal to bytes\nconst secret = Buffer.from(secretHex, \"hex\");\n\n// Calculate expected HMAC\nconst expectedSignature = crypto\n  .createHmac(\"sha256\", secret)\n  .update(`${timestampHeader}.`, \"utf8\")\n  .update(rawBody)\n  .digest();\n\nconst receivedSignatureBuffer = Buffer.from(\n  receivedSignature,\n  \"hex\"\n);\n\nif (\n  !crypto.timingSafeEqual(\n    expectedSignature,\n    receivedSignatureBuffer\n  )\n) {\n  return [{\n    json: {\n      valid: false,\n      reason: \"Signature verification failed.\"\n    }\n  }];\n}\n\n// Parse only after successful signature verification\nlet payload;\n\ntry {\n  payload = JSON.parse(rawBody.toString(\"utf8\"));\n} catch {\n  return [{\n    json: {\n      valid: false,\n      reason: \"Invalid JSON payload.\"\n    }\n  }];\n}\n\nreturn [{\n  json: {\n    valid: true,\n    event: payload.event\n  }\n}];\n"
      },
